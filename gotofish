#!/usr/bin/env zsh
# gotofish — gofish + fish-food integration for afeldman tools
# Installed to $HOME/.local/bin via scripts/install.sh
#
# Commands:
#   setup                    install gofish + register fish-food rig
#   update                   pull latest food definitions from rig
#   install <tool>           install a tool (update first)
#   upgrade [<tool>]         upgrade one or all tools (update first)
#   remove  <tool>           remove an installed tool
#   sync                     update + install missing + upgrade outdated
#   list                     show available vs installed tools
#   gen <tool> --release|--local [flags]   generate .lua food file

set -euo pipefail

# ── Config ────────────────────────────────────────────────────────────────────
GOFISH_RIG_URL="https://github.com/afeldman/fish-food"
GOFISH_RIG_NAME="fish-food"
DEV_PATH="${DEV_PATH:-/opt/dev}"
FISH_FOOD_DIR="${FISH_FOOD_DIR:-${DEV_PATH}/fish-food}"
RIG_FOOD_DIR="${HOME}/.gofish/rigs/${GOFISH_RIG_NAME}/Food"

if [[ -t 1 ]]; then
  RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[1;33m'
  BLUE='\033[0;34m' BOLD='\033[1m' RESET='\033[0m'
else
  RED='' GREEN='' YELLOW='' BLUE='' BOLD='' RESET=''
fi

info() { print "${BLUE}[info]${RESET} $*" }
ok()   { print "${GREEN}[ ok ]${RESET} $*" }
warn() { print "${YELLOW}[warn]${RESET} $*" >&2 }
die()  { print "${RED}[err ]${RESET} $*" >&2; exit 1 }

_require_gofish() {
  command -v gofish &>/dev/null || die "gofish not found — run: gotofish setup"
}

_food_dir() {
  # Prefer the rig directory (managed by gofish update)
  if [[ -d "$RIG_FOOD_DIR" ]]; then
    print "$RIG_FOOD_DIR"
  elif [[ -d "${FISH_FOOD_DIR}/Food" ]]; then
    print "${FISH_FOOD_DIR}/Food"
  else
    die "fish-food not found — run: gotofish setup"
  fi
}

# ── setup ─────────────────────────────────────────────────────────────────────
cmd_setup() {
  if ! command -v gofish &>/dev/null; then
    local src="${DEV_PATH}/gofish"
    [[ -d "$src" ]] || git clone --depth 1 https://github.com/afeldman/gofish.git "$src"
    command -v go &>/dev/null || die "go not found — install Go first"
    info "Building gofish..."
    (cd "$src" && GOBIN="${HOME}/.local/bin" go install ./...)
    command -v gofish &>/dev/null || die "gofish build failed"
  fi

  [[ -d "${HOME}/.gofish" ]] || gofish init

  if ! gofish rig list 2>/dev/null | grep -qF "$GOFISH_RIG_NAME"; then
    info "Registering rig: ${GOFISH_RIG_URL}"
    gofish rig add "$GOFISH_RIG_URL" || warn "rig add failed (may already exist)"
  fi

  gofish update 2>/dev/null || true
  ok "gofish setup complete"
}

# ── update ────────────────────────────────────────────────────────────────────
cmd_update() {
  _require_gofish
  info "Updating food definitions..."
  gofish update
  ok "update complete"
}

# ── install ───────────────────────────────────────────────────────────────────
cmd_install() {
  local tool="${1:-}"
  [[ -n "$tool" ]] || die "Usage: gotofish install <tool>"
  _require_gofish

  gofish update 2>/dev/null || true

  if gofish list 2>/dev/null | grep -q "^${tool}\b"; then
    warn "${tool} is already installed — use: gotofish upgrade ${tool}"
    return 0
  fi

  gofish install "$tool" && ok "Installed ${tool}" || die "install failed: ${tool}"
}

# ── upgrade ───────────────────────────────────────────────────────────────────
cmd_upgrade() {
  local tool="${1:-}"
  _require_gofish

  gofish update 2>/dev/null || true

  if [[ -n "$tool" ]]; then
    # Single tool
    gofish list 2>/dev/null | grep -q "^${tool}\b" \
      || die "${tool} is not installed — use: gotofish install ${tool}"
    gofish upgrade "$tool" && ok "Upgraded ${tool}" || die "upgrade failed: ${tool}"
  else
    # All installed tools from our rig
    local food_dir; food_dir=$(_food_dir)
    local -a errors=()
    local count=0

    while IFS= read -r lua; do
      local t; t=$(basename "$lua" .lua)
      gofish list 2>/dev/null | grep -q "^${t}\b" || continue
      gofish upgrade "$t" 2>/dev/null && (( count++ )) || errors+=("$t")
    done < <(find "$food_dir" -name '*.lua' | sort)

    ok "Upgraded ${count} tool(s)"
    (( ${#errors[@]} > 0 )) && warn "failed: ${errors[*]}"
  fi
}

# ── remove ────────────────────────────────────────────────────────────────────
cmd_remove() {
  local tool="${1:-}"
  [[ -n "$tool" ]] || die "Usage: gotofish remove <tool>"
  _require_gofish

  gofish list 2>/dev/null | grep -q "^${tool}\b" \
    || die "${tool} is not installed"

  gofish remove "$tool" && ok "Removed ${tool}" || die "remove failed: ${tool}"
}

# ── sync ──────────────────────────────────────────────────────────────────────
cmd_sync() {
  _require_gofish

  info "Updating food definitions..."
  gofish update 2>/dev/null || warn "gofish update failed — continuing with cached data"

  local food_dir; food_dir=$(_food_dir)
  local -a errors=()
  local installed=0 upgraded=0 skipped=0

  while IFS= read -r lua; do
    local tool; tool=$(basename "$lua" .lua)

    # Skip tools with empty sha256 (placeholder files not yet released)
    if grep -q 'sha256 = ""' "$lua" 2>/dev/null; then
      (( skipped++ ))
      continue
    fi

    if gofish list 2>/dev/null | grep -q "^${tool}\b"; then
      gofish upgrade "$tool" 2>/dev/null && (( upgraded++ )) || errors+=("$tool")
    else
      gofish install "$tool" 2>/dev/null && (( installed++ )) || errors+=("$tool")
    fi
  done < <(find "$food_dir" -name '*.lua' | sort)

  ok "sync: ${installed} installed, ${upgraded} upgraded, ${skipped} skipped (unreleased)"
  (( ${#errors[@]} > 0 )) && warn "failed: ${errors[*]}"
  return 0
}

# ── list ──────────────────────────────────────────────────────────────────────
cmd_list() {
  _require_gofish
  local food_dir; food_dir=$(_food_dir)

  printf "${BOLD}%-32s %-12s %-12s${RESET}\n" "Tool" "Available" "Installed"
  printf '%0.s─' {1..56}; print ""

  while IFS= read -r lua; do
    local tool; tool=$(basename "$lua" .lua)
    local available; available=$(grep -m1 'local version' "$lua" 2>/dev/null \
      | grep -oE '"[0-9][^"]+"' | tr -d '"' || print "?")
    local installed; installed=$(gofish list 2>/dev/null \
      | awk -v t="$tool" '$1==t {print $2}' || true)
    local status=""
    if [[ -z "$installed" ]]; then
      status="—"
    elif [[ "$installed" == "$available" ]]; then
      status="${GREEN}${installed}${RESET}"
    else
      status="${YELLOW}${installed} → ${available}${RESET}"
    fi
    printf "%-32s %-12s %b\n" "$tool" "$available" "$status"
  done < <(find "$food_dir" -name '*.lua' | sort)
}

# ── gen ───────────────────────────────────────────────────────────────────────
cmd_gen() {
  local mode="" tool="" binary="" version="" description="" homepage=""
  local bash_repo="" bash_tag="" bash_resources=""

  while (( $# > 0 )); do
    case "$1" in
      --release)   mode="release";      shift ;;
      --local)     mode="local";        shift ;;
      --bash)      mode="bash";         shift ;;
      --binary)    binary="$2";         shift 2 ;;
      --desc)      description="$2";    shift 2 ;;
      --homepage)  homepage="$2";       shift 2 ;;
      --version)   version="$2";        shift 2 ;;
      --output)    FISH_FOOD_DIR="$2";  shift 2 ;;
      --repo)      bash_repo="$2";      shift 2 ;;
      --tag)       bash_tag="$2";       shift 2 ;;
      --resources) bash_resources="$2"; shift 2 ;;
      -*)          die "Unknown flag: $1" ;;
      *)           tool="$1";           shift ;;
    esac
  done

  [[ -n "$tool" ]] || die "Usage: gotofish gen --release|--local|--bash <tool> [flags]"
  [[ -n "$mode" ]] || die "Specify --release, --local, or --bash"
  [[ -n "$binary" ]] || binary="$tool"

  # Read optional .gotofish project config (key=value)
  if [[ -f ".gotofish" ]]; then
    while IFS='=' read -r key val; do
      [[ "$key" == \#* || -z "$key" ]] && continue
      case "$key" in
        description) [[ -z "$description" ]] && description="$val" ;;
        binary)      [[ "$binary" == "$tool" ]] && binary="$val" ;;
        homepage)    [[ -z "$homepage" ]] && homepage="$val" ;;
      esac
    done < .gotofish
  fi

  # Resolve homepage
  if [[ -z "$homepage" ]]; then
    local repo="${GITHUB_REPOSITORY:-}"
    [[ -z "$repo" ]] && repo=$(git remote get-url origin 2>/dev/null \
      | sed 's|.*github\.com[:/]||; s|\.git$||' || true)
    [[ -n "$repo" ]] && homepage="https://github.com/${repo}"
  fi
  [[ -n "$homepage" ]] || die "Cannot determine homepage — set GITHUB_REPOSITORY or add homepage= to .gotofish"
  [[ -n "$description" ]] || description="$tool"

  # Bash mode
  if [[ "$mode" == "bash" ]]; then
    [[ -n "$bash_repo" ]] || die "--bash benötigt --repo owner/repo"
    [[ -n "$bash_tag"  ]] || die "--bash benötigt --tag vX.Y.Z"
    [[ -n "$bash_resources" ]] || die "--bash benötigt --resources file1,file2,..."

    local repo_name="${bash_repo##*/}"
    local version="${bash_tag#v}"          # v0.3.0 → 0.3.0
    local tarball_url="https://github.com/${bash_repo}/archive/refs/tags/${bash_tag}.tar.gz"

    info "Downloading tarball to compute sha256..."
    local sha256
    sha256=$(curl -fsSL "$tarball_url" | shasum -a 256 | awk '{print $1}')
    [[ -n "$sha256" ]] || die "sha256 Berechnung fehlgeschlagen"
    ok "sha256: $sha256"

    local out_dir="${FISH_FOOD_DIR}/Food"
    mkdir -p "$out_dir"
    local lua_file="${out_dir}/${tool}.lua"

    # Resources aus komma-getrennter Liste
    local -a res_list=("${(@s/,/)bash_resources}")

    {
      print "local name = \"${tool}\""
      print "local version = \"${version}\""
      print ""
      print "food = {"
      print "    name = name,"
      print "    description = \"${description}\","
      print "    homepage = \"https://github.com/${bash_repo}\","
      print "    version = version,"
      print "    packages = {"
      for os in darwin linux; do
        for arch in amd64 arm64; do
          print "        {"
          print "            os = \"${os}\","
          print "            arch = \"${arch}\","
          print "            url = \"${tarball_url}\","
          print "            sha256 = \"${sha256}\","
          print "            resources = {"
          for res in "${res_list[@]}"; do
            # GitHub source archives: <repo>-<version>/<file>
            print "                { path = \"${repo_name}-${version}/${res}\", installpath = \"bin/${res}\", executable = true },"
          done
          print "            }"
          print "        },"
        done
      done
      print "    }"
      print "}"
    } > "$lua_file"

    ok "Generated: ${lua_file}"
    [[ "$mode" == "bash" ]] && _commit_food "$tool" "$version" "$lua_file"
    return 0
  fi

  # Release/Local mode (original logic)
  local repo_path="${homepage#https://github.com/}"
  local checksums="dist/checksums.txt"
  [[ -f "$checksums" ]] || die "Not found: ${checksums} — run goreleaser from project root first"

  typeset -A packages  # "os_arch" → "sha256|url"

  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    local sha256 filename
    read -r sha256 filename <<< "$line"
    [[ "$filename" == ${tool}_*.tar.gz ]] || continue

    local rest="${filename#${tool}_}"
    [[ -z "$version" ]] && version="${rest%%_*}"
    rest="${rest#${version}_}"
    local os="${rest%%_*}"
    local arch="${rest#${os}_}"; arch="${arch%.tar.gz}"
    [[ "$os" == "linux" || "$os" == "darwin" ]] || continue

    packages["${os}_${arch}"]="${sha256}|https://github.com/${repo_path}/releases/download/v${version}/${filename}"
  done < "$checksums"

  (( ${#packages[@]} > 0 )) || die "No matching archives in ${checksums} for: ${tool}"
  [[ -n "$version" ]] || die "Could not determine version from ${checksums}"

  local out_dir="${FISH_FOOD_DIR}/Food"
  mkdir -p "$out_dir"
  local lua_file="${out_dir}/${tool}.lua"

  {
    print "local name = \"${tool}\""
    print "local version = \"${version}\""
    print ""
    print "food = {"
    print "    name = name,"
    print "    description = \"${description}\","
    print "    homepage = \"${homepage}\","
    print "    version = version,"
    print "    packages = {"
    for key in darwin_amd64 darwin_arm64 linux_amd64 linux_arm64; do
      [[ -v "packages[$key]" ]] || continue
      local os="${key%%_*}" arch="${key#*_}"
      local sha256="${packages[$key]%%|*}" url="${packages[$key]##*|}"
      print "        {"
      print "            os = \"${os}\","
      print "            arch = \"${arch}\","
      print "            url = \"${url}\","
      print "            sha256 = \"${sha256}\","
      print "            resources = {"
      print "                { path = \"${binary}\", installpath = \"bin/${binary}\", executable = true }"
      print "            }"
      print "        },"
    done
    print "    }"
    print "}"
  } > "$lua_file"

  ok "Generated: ${lua_file}"
  [[ "$mode" == "release" ]] && _commit_food "$tool" "$version" "$lua_file"
  return 0
}

# ── commit helper ─────────────────────────────────────────────────────────────
_commit_food() {
  local tool="$1" version="$2" lua_file="$3"
  local work_dir="$FISH_FOOD_DIR"

  if [[ "${GITHUB_ACTIONS:-}" == "true" ]]; then
    local token="${FISH_FOOD_TOKEN:-${GITHUB_TOKEN:-}}"
    [[ -n "$token" ]] || die "Set FISH_FOOD_TOKEN (or GITHUB_TOKEN) for fish-food push"
    local rp; rp=$(echo "$GOFISH_RIG_URL" | sed 's|https://github.com/||')
    work_dir=$(mktemp -d)
    git clone "https://x-access-token:${token}@github.com/${rp}.git" "$work_dir"
    cp "$lua_file" "${work_dir}/Food/${tool}.lua"
  fi

  [[ -d "${work_dir}/.git" ]] || { warn "fish-food not a git repo — skipping push"; return 0; }

  (
    cd "$work_dir"
    git config user.email "goreleaser@github-actions" 2>/dev/null || true
    git config user.name  "GoReleaser"                2>/dev/null || true
    git pull --rebase --quiet || warn "git pull --rebase failed"
    git add "Food/${tool}.lua"
    git diff --cached --quiet && { info "No changes to push for ${tool}"; return 0; }
    git commit -m "chore: update ${tool} to ${version}"
    git push || die "git push failed — push manually from ${work_dir}"
    ok "Pushed ${tool} v${version} to fish-food"
  )

  [[ "${GITHUB_ACTIONS:-}" == "true" ]] && rm -rf "$work_dir"
  return 0
}

# ── dispatch ──────────────────────────────────────────────────────────────────
case "${1:-help}" in
  setup)   shift; cmd_setup   "$@" ;;
  update)  shift; cmd_update  "$@" ;;
  install) shift; cmd_install "$@" ;;
  upgrade) shift; cmd_upgrade "$@" ;;
  remove)  shift; cmd_remove  "$@" ;;
  sync)    shift; cmd_sync    "$@" ;;
  list)    shift; cmd_list    "$@" ;;
  gen)     shift; cmd_gen     "$@" ;;
  help|--help|-h)
    print "${BOLD}gotofish${RESET} — gofish lifecycle manager for afeldman tools"
    print ""
    print "Commands:"
    print "  setup                    install gofish + register fish-food rig"
    print "  update                   pull latest food definitions from rig"
    print "  install <tool>           install a tool"
    print "  upgrade [<tool>]         upgrade one tool or all installed tools"
    print "  remove  <tool>           remove a tool"
    print "  sync                     update + install missing + upgrade outdated"
    print "  list                     show available vs installed (with update status)"
    print "  gen <tool>               generate .lua food file from goreleaser artifacts"
    print "    --release                CI mode: reads dist/checksums.txt, pushes to fish-food"
    print "    --local                  local mode: same but no push"
    print "    --bash                   bash/shell mode: benutzt GitHub source tarball statt dist/checksums.txt"
    print "    --binary <name>          binary name inside archive (default: tool name)"
    print "    --desc <text>            tool description"
    print "    --homepage <url>         override homepage URL"
    print "    --output <dir>           override fish-food output directory"
    print "    --repo <owner/repo>      GitHub repo (z.B. afeldman/scripts) (bash mode only)"
    print "    --tag  <vX.Y.Z>          release tag (bash mode only)"
    print "    --resources <files>      komma-getrennt: welche Dateien installiert werden (bash mode only)"
    print ""
    print "Env vars:"
    print "  DEV_PATH           base directory (default: /opt/dev)"
    print "  FISH_FOOD_DIR      fish-food repo path (default: \$DEV_PATH/fish-food)"
    print "  GITHUB_REPOSITORY  owner/repo for release URLs (set by GitHub Actions)"
    print "  FISH_FOOD_TOKEN    PAT with write access to fish-food (for CI push)"
    ;;
  *) die "Unknown command: ${1}. Run: gotofish help" ;;
esac
